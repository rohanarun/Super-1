    },
    {
      "id": "F2-baseline-gets-more-body",
      "statement": "At a comparable total, nanoGPT d=640/6L holds 29534720 body parameters against the hierarchy's 15162832 (1.95x more).",
      "consequence": "Part of the observed hierarchy deficit is explainable by allocation rather than by recurrence, and must be excluded before any architecture claim."
    },
    {
      "id": "F3-embedding-untrained-at-budget",
      "statement": "At the 10M-token budget the V=151936 embedding gives each row 66 tokens.",
      "consequence": "That table is essentially untrained, so a V=151936 short-budget comparison mostly measures embedding efficiency."
    },
    {
      "id": "F4-vocab-shrink-frees-budget",
      "statement": "Holding the exact recovered body width d=688, V=32768 costs 37707216 parameters versus 119694800 at V=151936, freeing 81987584.",
      "consequence": "Vocabulary is the cheapest declared lever available and leaves the gates, clocks and recurrence untouched."
    },
    {
      "id": "F5-not-a-quality-result",
      "statement": "No model was trained and no loss, quality or frontier number was produced.",
      "consequence": "These are analytic parameter counts. They do not license any quality, SOTA, novelty or transfer claim."
    }
  ],
  "decision_rule": "If a matched-context comparison at the reallocated budget still loses to nanoGPT, the allocation explanation is falsified and the recurrence carries the remaining deficit. Only that outcome may be reported as an architecture result."
